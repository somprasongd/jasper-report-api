<jasperReport name="demo" language="groovy" resourceBundle="messages" whenResourceMissingType="Key" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5b0f1a64-0b1e-4c5e-9d11-6a0d2d3a1001">
	<!-- logical datasource and default language of this report; a request can override both -->
	<property name="report.datasource" value="opd"/>
	<property name="report.locale" value="th"/>
	<parameter name="SUBREPORTS" class="java.util.Map"/>
	<parameter name="IMAGE_DIR" class="java.lang.String"/>
	<!-- set by the API to the language of the resolved locale ("th", "en", ...); lets the query pick translated data -->
	<parameter name="REPORT_LANGUAGE" class="java.lang.String"/>
	<parameter name="hn" class="java.lang.String"/>
	<parameter name="print_time" class="java.sql.Timestamp"/>
	<query language="sql"><![CDATA[select hn, case when $P{REPORT_LANGUAGE} = 'en' then name_en else name end as name from patient where hn = $P{hn}]]></query>
	<field name="hn" class="java.lang.String"/>
	<field name="name" class="java.lang.String"/>
	<title height="330" splitType="Stretch">
		<element kind="textField" uuid="5b0f1a64-0b1e-4c5e-9d11-6a0d2d3a1002" x="0" y="0" width="555" height="36" hTextAlign="Center" fontName="TH Sarabun New" fontSize="22" bold="true">
			<expression><![CDATA[$R{title}]]></expression>
		</element>
		<element kind="textField" uuid="5b0f1a64-0b1e-4c5e-9d11-6a0d2d3a1003" x="0" y="40" width="400" height="24" fontName="TH Sarabun New" fontSize="18">
			<expression><![CDATA[$R{patient} + ": " + $F{name} + "  HN " + $F{hn}]]></expression>
		</element>
		<element kind="textField" uuid="5b0f1a64-0b1e-4c5e-9d11-6a0d2d3a1004" x="0" y="64" width="400" height="24" blankWhenNull="true" fontName="TH Sarabun New" fontSize="16">
			<expression><![CDATA[$P{print_time} == null ? "" : $R{printed_at} + " " + new java.text.SimpleDateFormat("d MMMM yyyy HH:mm", $P{REPORT_LOCALE}).format($P{print_time})]]></expression>
		</element>
		<element kind="image" uuid="5b0f1a64-0b1e-4c5e-9d11-6a0d2d3a1005" x="470" y="0" width="40" height="40">
			<expression><![CDATA[$P{IMAGE_DIR} + "logo.png"]]></expression>
		</element>
		<element kind="component" uuid="5b0f1a64-0b1e-4c5e-9d11-6a0d2d3a1006" x="0" y="100" width="100" height="100">
			<component kind="barcode4j:QRCode" errorCorrectionLevel="M">
				<codeExpression><![CDATA["HN:" + $F{hn} + " " + $F{name}]]></codeExpression>
			</component>
		</element>
		<element kind="component" uuid="5b0f1a64-0b1e-4c5e-9d11-6a0d2d3a1007" x="150" y="100" width="250" height="60">
			<component kind="barcode4j:Code128">
				<codeExpression><![CDATA[$F{hn}]]></codeExpression>
			</component>
		</element>
		<element kind="subreport" uuid="5b0f1a64-0b1e-4c5e-9d11-6a0d2d3a1008" x="0" y="220" width="555" height="60">
			<parameter name="hn">
				<expression><![CDATA[$P{hn}]]></expression>
			</parameter>
			<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
			<expression><![CDATA[((net.sf.jasperreports.engine.JasperReport)$P{SUBREPORTS}.get("sub_info"))]]></expression>
		</element>
	</title>
</jasperReport>
