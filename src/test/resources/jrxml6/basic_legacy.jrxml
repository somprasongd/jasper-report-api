<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic JR 6 report for the converter tests: styles, groups, variables, every plain element and every band. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="basic_legacy" language="java" columnCount="1" printOrder="Vertical" pageWidth="595" pageHeight="842" columnWidth="555" columnSpacing="0" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" isTitleNewPage="false" isSummaryNewPage="false" isSummaryWithPageHeaderAndFooter="true" isFloatColumnFooter="true" isIgnorePagination="false" uuid="11111111-1111-4111-8111-000000000001">
	<property name="ireport.zoom" value="1.5"/>
	<property name="report.datasource" value="opd"/>
	<propertyExpression name="net.sf.jasperreports.export.pdf.title"><![CDATA["Basic " + $P{who}]]></propertyExpression>
	<import value="java.text.*"/>
	<import value="java.util.*"/>
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="10"/>
	<style name="Header" style="Base" mode="Opaque" forecolor="#112233" backcolor="#DDDDDD" fill="Solid" radius="2" hAlign="Center" vAlign="Middle" rotation="None" markup="none" isBold="true" isItalic="true" isUnderline="false" isStrikeThrough="false" pdfFontName="Helvetica-Bold" pdfEncoding="Cp1252" isPdfEmbedded="false">
		<pen lineWidth="0.5" lineStyle="Dashed" lineColor="#445566"/>
		<box padding="2" topPadding="3">
			<pen lineWidth="1.0" lineColor="#333333"/>
			<topPen lineWidth="2.0" lineStyle="Dotted"/>
			<bottomPen lineWidth="0.25"/>
		</box>
		<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="4" leftIndent="1" rightIndent="2" spacingBefore="3" spacingAfter="5" tabStopWidth="30">
			<tabStop position="60" alignment="Right"/>
		</paragraph>
	</style>
	<style name="Zebra" style="Base">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#EEEEEE" isBold="true">
				<box padding="1"/>
			</style>
		</conditionalStyle>
	</style>
	<parameter name="who" class="java.lang.String">
		<parameterDescription><![CDATA[Who to greet]]></parameterDescription>
		<defaultValueExpression><![CDATA["World"]]></defaultValueExpression>
	</parameter>
	<parameter name="threshold" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[Integer.valueOf(4)]]></defaultValueExpression>
	</parameter>
	<queryString language="sql">
		<![CDATA[select grp, item, qty from items order by grp, item]]>
	</queryString>
	<field name="grp" class="java.lang.String">
		<fieldDescription><![CDATA[group name]]></fieldDescription>
	</field>
	<field name="item" class="java.lang.String"/>
	<field name="qty" class="java.lang.Integer">
		<property name="field.note" value="n"/>
	</field>
	<sortField name="grp" order="Ascending"/>
	<variable name="total_qty" class="java.lang.Integer" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
		<initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
	</variable>
	<variable name="grp_qty" class="java.lang.Integer" resetType="Group" resetGroup="by_grp" calculation="Sum">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
	</variable>
	<filterExpression><![CDATA[$F{qty} != null]]></filterExpression>
	<group name="by_grp" isStartNewColumn="false" isStartNewPage="false" isResetPageNumber="false" isReprintHeaderOnEachPage="true" minHeightToStartNewPage="30" footerPosition="Normal" keepTogether="true">
		<groupExpression><![CDATA[$F{grp}]]></groupExpression>
		<groupHeader>
			<band height="22">
				<textField>
					<reportElement style="Header" mode="Opaque" x="0" y="0" width="555" height="20" uuid="11111111-1111-4111-8111-000000000010"/>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA["Group " + $F{grp}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="22">
				<textField>
					<reportElement x="300" y="0" width="255" height="20"/>
					<textElement textAlignment="Right">
						<font isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["Subtotal " + $F{grp} + ": " + $V{grp_qty}]]></textFieldExpression>
				</textField>
			</band>
		</groupFooter>
	</group>
	<background>
		<band height="0"/>
	</background>
	<title>
		<band height="110" splitType="Stretch">
			<printWhenExpression><![CDATA[Boolean.TRUE]]></printWhenExpression>
			<staticText>
				<reportElement key="greeting-label" x="0" y="0" width="120" height="24" forecolor="#990000" backcolor="#FFFFCC" mode="Opaque" uuid="11111111-1111-4111-8111-000000000011">
					<property name="element.note" value="static"/>
					<propertyExpression name="element.expr"><![CDATA["e"]]></propertyExpression>
				</reportElement>
				<box padding="2">
					<pen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Bottom" rotation="None" markup="none">
					<font fontName="DejaVu Sans" size="12" isBold="true" isItalic="true" isUnderline="true" isStrikeThrough="false" pdfFontName="Helvetica-BoldOblique" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Double" spacingBefore="1"/>
				</textElement>
				<text><![CDATA[Greeting <&> text]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true" evaluationTime="Now" pattern="" hyperlinkType="Reference" hyperlinkTarget="Blank" bookmarkLevel="1">
				<reportElement x="130" y="0" width="200" height="24" positionType="Float" stretchType="RelativeToTallestObject" isPrintRepeatedValues="false" isRemoveLineWhenBlank="true" isPrintInFirstWholeBand="true" isPrintWhenDetailOverflows="true" printWhenGroupChanges="by_grp"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" lineSpacing="Single"/>
				<textFieldExpression class="java.lang.String"><![CDATA["Hello " + $P{who}]]></textFieldExpression>
				<anchorNameExpression><![CDATA["greet"]]></anchorNameExpression>
				<bookmarkLevelExpression><![CDATA[Integer.valueOf(1)]]></bookmarkLevelExpression>
				<hyperlinkReferenceExpression><![CDATA["http://example.org/" + $P{who}]]></hyperlinkReferenceExpression>
				<hyperlinkWhenExpression><![CDATA[Boolean.TRUE]]></hyperlinkWhenExpression>
				<hyperlinkTooltipExpression><![CDATA["tip"]]></hyperlinkTooltipExpression>
				<hyperlinkParameter name="p1">
					<hyperlinkParameterExpression><![CDATA["v1"]]></hyperlinkParameterExpression>
				</hyperlinkParameter>
			</textField>
			<textField pattern="#,##0.00" evaluationTime="Report" isBlankWhenNull="false">
				<reportElement x="340" y="0" width="100" height="24" backcolor="#00FF00"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$V{total_qty}]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Group" evaluationGroup="by_grp">
				<reportElement x="450" y="0" width="100" height="24"/>
				<textFieldExpression><![CDATA[$V{grp_qty}]]></textFieldExpression>
			</textField>
			<!-- picture row -->
			<image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" isUsingCache="true" isLazy="false" onErrorType="Blank" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self">
				<reportElement x="0" y="30" width="60" height="30"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<graphicElement fill="Solid">
					<pen lineWidth="0.5" lineStyle="Dotted"/>
				</graphicElement>
				<imageExpression><![CDATA[null]]></imageExpression>
			</image>
			<line direction="BottomUp">
				<reportElement x="70" y="30" width="100" height="30" forecolor="#0000FF"/>
				<graphicElement>
					<pen lineWidth="2.0" lineStyle="Dashed" lineColor="#FF0000"/>
				</graphicElement>
			</line>
			<rectangle radius="5">
				<reportElement x="180" y="30" width="60" height="30" backcolor="#CCCCCC" mode="Opaque"/>
				<graphicElement fill="Solid">
					<pen lineWidth="1.0"/>
				</graphicElement>
			</rectangle>
			<ellipse>
				<reportElement x="250" y="30" width="60" height="30"/>
				<graphicElement>
					<pen lineWidth="1.5"/>
				</graphicElement>
			</ellipse>
			<!-- a column break that never fires (the report has one column, it would start a new page) -->
			<break type="Column">
				<reportElement x="0" y="60" width="10" height="1">
					<printWhenExpression><![CDATA[Boolean.FALSE]]></printWhenExpression>
				</reportElement>
			</break>
			<frame>
				<reportElement x="0" y="65" width="555" height="40" mode="Opaque" backcolor="#F0F0F0"/>
				<box>
					<pen lineWidth="1.0" lineColor="#999999"/>
					<leftPen lineWidth="3.0"/>
				</box>
				<staticText>
					<reportElement x="5" y="5" width="100" height="20"/>
					<text><![CDATA[Inside frame]]></text>
				</staticText>
				<elementGroup>
					<textField>
						<reportElement x="110" y="5" width="200" height="20"/>
						<textFieldExpression><![CDATA["Grouped " + $P{threshold}]]></textFieldExpression>
					</textField>
				</elementGroup>
			</frame>
		</band>
	</title>
	<pageHeader>
		<band height="24">
			<staticText>
				<reportElement style="Header" x="0" y="2" width="300" height="20"/>
				<text><![CDATA[Item]]></text>
			</staticText>
			<staticText>
				<reportElement style="Header" x="300" y="2" width="255" height="20"/>
				<text><![CDATA[Quantity]]></text>
			</staticText>
		</band>
	</pageHeader>
	<columnHeader>
		<band height="0"/>
	</columnHeader>
	<detail>
		<band height="20" splitType="Prevent">
			<textField>
				<reportElement style="Zebra" mode="Opaque" x="0" y="0" width="300" height="20"/>
				<textFieldExpression><![CDATA[$F{item}]]></textFieldExpression>
			</textField>
			<textField pattern="000">
				<reportElement style="Zebra" x="300" y="0" width="255" height="20"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{qty}]]></textFieldExpression>
			</textField>
		</band>
		<band height="0"/>
	</detail>
	<columnFooter>
		<band height="0"/>
	</columnFooter>
	<pageFooter>
		<band height="20">
			<textField>
				<reportElement x="0" y="0" width="100" height="20"/>
				<textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="100" y="0" width="100" height="20"/>
				<textFieldExpression><![CDATA[" of " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<lastPageFooter>
		<band height="20">
			<staticText>
				<reportElement x="0" y="0" width="200" height="20"/>
				<text><![CDATA[Last page footer]]></text>
			</staticText>
		</band>
	</lastPageFooter>
	<summary>
		<band height="24" isSplitAllowed="false">
			<textField>
				<reportElement x="0" y="2" width="555" height="20"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Total " + $V{total_qty}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
	<noData>
		<band height="20">
			<staticText>
				<reportElement x="0" y="0" width="200" height="20"/>
				<text><![CDATA[No data]]></text>
			</staticText>
		</band>
	</noData>
</jasperReport>
