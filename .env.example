# Copy to .env and edit. docker compose reads it for both the compose file and the container.
# Never commit .env.

# ---- API key (generate with: make api-key CLIENT=hosos-web) ------------------------------------------
# required (default) | optional (accept no key, reject a wrong one) | disabled (dev only)
API_KEY_MODE=required
REPORT_SECURITY_API_KEYS_0_CLIENT_ID=hosos-web
REPORT_SECURITY_API_KEYS_0_SHA256=<sha256 printed by scripts/api-key.sh>

# ---- databases the reports query. Use a read-only database user. ---------------------------------------
OPD_DB_URL=jdbc:postgresql://host.docker.internal:5432/hosv4
OPD_DB_USER=report_ro
OPD_DB_PASSWORD=change-me
# IPD_DB_URL=jdbc:postgresql://host.docker.internal:5432/ipd
# IPD_DB_USER=report_ro
# IPD_DB_PASSWORD=change-me

# ---- report folder on the host, mounted read-only at /app/reports -------------------------------------
REPORTS_DIR=./reports

# ---- optional: S3-compatible storage (rustfs, MinIO, AWS S3) -------------------------------------------
# S3_ENDPOINT=http://rustfs:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ALLOWED_BUCKETS=reports

# ---- optional: let reports be downloaded from these hosts (comma separated), off by default -------------
# HTTP_ALLOWED_HOSTS=files.internal

# ---- network / JVM ----------------------------------------------------------------------------------
# API_BIND=127.0.0.1
# API_PORT=8080
# JAVA_OPTS=-XX:MaxRAMPercentage=75
